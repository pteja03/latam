# Copiar a .env y completar. .env NUNCA se versiona.
ENTORNO=desarrollo

# --- Base de datos y Redis ---
POSTGRES_PASSWORD=cambia_esto
DATABASE_URL=postgresql+asyncpg://agenda:cambia_esto@postgres:5432/agenda
REDIS_URL=redis://redis:6379/0

# --- Seguridad ---
# Una o varias llaves Fernet separadas por coma. La primera cifra, todas descifran.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
# Modelo Flash vigente con audio y function calling. Nunca hardcodeado en el codigo.
GEMINI_MODEL=gemini-flash-latest

# --- WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v23.0
# Plantillas aprobadas por Meta (IA-16, IA-18)
WA_PLANTILLA_CIERRE=cierre_diario
WA_PLANTILLA_RECORDATORIO=recordatorio_tarea
WA_PLANTILLA_IDIOMA=es_MX

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agenda.ejemplo.com/api/google/oauth/callback

# --- Despliegue (proxy TLS) ---
DOMINIO=agenda.ejemplo.com
ACME_EMAIL=admin@ejemplo.com

# --- UI ---
API_CORE_URL=http://api_core:8000/api
